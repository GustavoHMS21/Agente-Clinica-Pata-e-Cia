# Copie para .env e preencha. O .env está no .gitignore e nunca vai para o repositório.
# Este arquivo vai para o git, então nunca coloque um valor real aqui.

# Caminho do banco SQLite (opcional; padrão: data/patas.db)
PATAS_DB_PATH=data/patas.db

# Qual LLM o agente usa: anthropic (padrão) | gemini (alternativa, ADR 0006)
LLM_PROVEDOR=anthropic
# Opcional: só o nome do modelo, sem prefixo. Padrões: anthropic claude-sonnet-5-5; gemini gemini-2.5-flash
LLM_MODELO=

# Login do servidor web (simulador e painel da Joyce). Sem os dois, o servidor não sobe.
# Senha com pelo menos 12 caracteres. Nunca reutilize uma senha sua de outro serviço.
PAINEL_USUARIO=
PAINEL_SENHA=

# Chaves: só no .env local e, no deploy, no cofre de segredos da plataforma.
# Nunca em código, doc, log, print ou chat. Só a do provedor escolhido precisa estar preenchida.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (docs/configurar-integracoes.md). Os IDs não são segredo; token, app secret e
# verify token são.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Google Agenda do banho e tosa (docs/configurar-integracoes.md). O ID da agenda não é segredo;
# o JSON da conta de serviço é, e fica na pasta segredos/ (bloqueada no git e na imagem Docker).
GOOGLE_AGENDA_ID=
GOOGLE_CREDENCIAIS=segredos/google-agenda.json
