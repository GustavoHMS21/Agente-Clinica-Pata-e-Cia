# Variante local da Qwen3 para o agente da Patas & Cia (ADR 0006).
#
# Por quê: o Ollama roda modelos com janela de 4.096 tokens por padrão. Só o prompt de
# sistema + as 8 ferramentas ocupam perto disso; com o histórico, o Ollama corta o
# início da conversa sem avisar e o modelo perde as regras (inclusive o limite de saúde).
#
# Criar uma vez:  ollama create patas-qwen3 -f ollama/Modelfile
# Usar:           LLM_PROVEDOR=ollama no .env (patas-qwen3 é o modelo padrão do provedor)

FROM qwen3:8b

# 16k tokens: prompt + ferramentas (~4k) + 10 turnos de histórico com folga.
# Custa mais RAM (cache de atenção); em 16 GB de RAM cabe.
PARAMETER num_ctx 16384
